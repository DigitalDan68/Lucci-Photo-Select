{
  "name": "photoapp",
  "version": "0.2.0",
  "packageManager": "pnpm@11.19.0",
  "description": "Lucci Photo Video's cross-platform photo culling and selection app",
  "main": "dist-electron/main.js",
  "author": "Lucci Photo Video",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.main.json --watch\" \"wait-on tcp:5173 file:dist-electron/main.js && electron .\"",
    "build": "tsc -p tsconfig.main.json && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "dist:mac": "pnpm build && electron-builder --mac dmg zip --publish never",
    "dist:win": "pnpm build && electron-builder --win nsis portable --publish never",
    "dist": "pnpm build && electron-builder -mw --publish never",
    "test": "tsc -p tsconfig.main.json && node --test tests/*.cjs"
  },
  "dependencies": {
    "@tensorflow-models/blazeface": "^0.1.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@vitejs/plugin-react": "latest",
    "exifr": "^7.1.3",
    "libraw-wasm": "1.6.0",
    "electron-updater": "^6.6.2",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.lucciphotovideo.photoapp",
    "productName": "Lucci's Photo Select",
    "publish": [{"provider":"github","owner":"DigitalDan68","repo":"Lucci-Photo-Select"}],
    "asar": true,
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "models/**/*",
      "build/icon.png",
      "THIRD_PARTY_NOTICES.md",
      "package.json",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "asarUnpack": ["node_modules/libraw-wasm/**/*"],
    "mac": {
      "category": "public.app-category.photography",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
