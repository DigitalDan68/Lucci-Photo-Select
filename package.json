{
  "name": "photoapp",
  "version": "0.1.0",
  "packageManager": "pnpm@11.19.0",
  "description": "Lucci Photo Video's cross-platform photo culling and selection app",
  "main": "dist-electron/main.js",
  "author": "Lucci Photo Video",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.main.json --watch\" \"wait-on tcp:5173 file:dist-electron/main.js && electron .\"",
    "build": "tsc -p tsconfig.main.json && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "dist:mac": "pnpm build && electron-builder --mac dmg zip",
    "dist:win": "pnpm build && electron-builder --win nsis portable",
    "dist": "pnpm build && electron-builder -mw"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest",
    "sharp": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.lucciphotovideo.photoapp",
    "productName": "Lucci's Photo Select",
    "asar": true,
    "files": ["dist/**/*", "dist-electron/**/*", "package.json", "node_modules/**/*"],
    "directories": { "output": "release" },
    "mac": { "category": "public.app-category.photography", "target": ["dmg", "zip"], "icon": "build/icon.png" },
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
